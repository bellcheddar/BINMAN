# environments
.pixi/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# large or regenerable data
data/cache/
data/interim/
# stage manifests are regenerable and large (catalogue.jsonl is ~132 MB)
data/manifests/*.jsonl
data/atlas/*.sqlite
# SQLite's write-ahead log and shared-memory files. They exist only while a
# connection is open, and a commit made during a build swept two of them in.
data/atlas/*.sqlite-shm
data/atlas/*.sqlite-wal
data/atlas/*.duckdb
data/afdb/
app/static/structures/*.cif.gz
app/static/structures/*.bcif

# third-party validation datasets: never redistributed (spec 4.1b licence rule).
# Only MANIFEST.md and computed metrics are tracked. Parsed derivatives stay local
# even where the source licence would permit redistribution, so that the rule is
# enforced by one pattern rather than by remembering which source allows what.
data/validation/raw/
data/validation/*.tsv
data/validation/*.csv
data/validation/*.jsonl
data/validation/*.txt
data/validation/*.gz

# Model weights: never committed, never shipped to the droplet (spec 3.9).
# Covers every adapter directory, including the rejected DPO attempts and the
# per-round training directories, not just the two named paths.
models/**/*.safetensors
models/**/*.npz
models/**/*.bin
models/**/*.gguf
models/binman-lm/adapters/*
models/binman-lm/adapters-dpo/*
models/binman-lm/fused/*
models/binman-lm/runs/
!models/binman-lm/adapters/.gitkeep
!models/binman-lm/fused/.gitkeep
# training.json is a report, not a weight, and the About tab reads it
!models/binman-lm/training.json

# Weights & Biases local run directories (the runs themselves live on wandb.ai)
wandb/
**/wandb/

# QC output
qc/screenshots/
qc/reports/

# macOS
.DS_Store

# Converted adapter weights staged for HuggingFace upload. The Hub is the
# distribution channel for these, not git: the repo carries the card and the
# licence, not 50 MB of safetensors.
deploy/hf-adapter/*.safetensors
